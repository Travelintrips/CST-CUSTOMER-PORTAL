modules = ["nodejs-24", "python-base-3.13"]
[userenv]

[userenv.shared]

[userenv.development]
APP_ENV = "development"
VITE_API_SERVER_URL_DEV = "https://1c591a26-1875-444f-9a51-2733d23fd756-00-3bxi1sstpdetn.pike.replit.dev"

[userenv.production]
APP_ENV = "production"
MKT_DUAL_WRITE_RETRY_ENABLED = "false"

[[ports]]
