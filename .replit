modules = ["nodejs-20", "python-3.12", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]

[userenv.development]
APP_ENV = "development"

[userenv.production]
APP_ENV = "production"
MKT_DUAL_WRITE_RETRY_ENABLED = "false"
