modules = ["nodejs-20", "python-3.12", "web"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.shared]
VITE_API_SERVER_URL = "https://cstlogistic.co.id"

[userenv.development]
APP_ENV = "development"
VITE_API_SERVER_URL_DEV = "https://1c591a26-1875-444f-9a51-2733d23fd756-00-3bxi1sstpdetn.pike.replit.dev"

[userenv.production]
APP_ENV = "production"
MKT_DUAL_WRITE_RETRY_ENABLED = "false"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 18444
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Customer Portal API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Customer Portal API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm api:dev"
waitForPort = 18444

[workflows.workflow.metadata]
outputType = "console"
