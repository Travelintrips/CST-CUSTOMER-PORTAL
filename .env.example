# Customer Portal frontend uses its standalone same-origin /api routes.
# Optional Supabase values used by client-side auth/assets where applicable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL_DEV=
VITE_SUPABASE_ANON_KEY_DEV=
GOOGLE_MAPS_API_KEY=

# Google OAuth login (server-side)
# Redirect override is optional; production can derive https://<request-host>/api/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_BASE_URL=


# Trucking provider owner (PT Cahaya Sejati Teknologi)
TRUCKING_PROVIDER_COMPANY_ID=1


# Logistic order payment provider owner (PT Cahaya Sejati Teknologi)
LOGISTIC_PROVIDER_COMPANY_ID=1

# Optional override. Production defaults to false when configuration row is absent.
PAYLABS_SANDBOX_MODE=false


# Production runtime lifecycle
# Startup waits for DB + private storage before opening the public port.
PORTAL_STARTUP_MAX_ATTEMPTS=8
PORTAL_STARTUP_RETRY_MS=1500
# On SIGTERM, keep serving briefly while readiness turns false so the proxy can drain.
PORTAL_DRAIN_DELAY_MS=5000
PORTAL_SHUTDOWN_TIMEOUT_MS=25000
PORTAL_KEEPALIVE_TIMEOUT_MS=65000
PORTAL_HEADERS_TIMEOUT_MS=66000
