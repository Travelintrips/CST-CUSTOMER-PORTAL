# URL of the shared API Server. For local development, the default is http://127.0.0.1:18444.
VITE_API_SERVER_URL=http://127.0.0.1:18444
# Optional development-only override. When set, pnpm dev uses this before
# VITE_API_SERVER_URL so dev-only login works against the dev API.
VITE_API_SERVER_URL_DEV=
# Optional Supabase values used by client-side auth/assets where applicable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL_DEV=
VITE_SUPABASE_ANON_KEY_DEV=
GOOGLE_MAPS_API_KEY=
