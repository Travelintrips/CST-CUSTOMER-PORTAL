FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
COPY package.json pnpm-lock.yaml .npmrc ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG DEV_RELEASE_SHA
ENV APP_ENV=development NODE_ENV=development
RUN PORTAL_RELEASE_ID="${DEV_RELEASE_SHA:-dev-vps}" pnpm build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/server ./server
COPY --from=build /app/scripts/start-dev-vps.mjs ./scripts/start-dev-vps.mjs
COPY --from=build /app/package.json ./package.json
ENV APP_ENV=development NODE_ENV=development PORT=18444 CUSTOMER_PORTAL_PUBLIC_DIR=/app/dist/public
USER node
EXPOSE 18444
CMD ["node", "scripts/start-dev-vps.mjs"]
